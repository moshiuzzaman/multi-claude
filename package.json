{
  "name": "multi-claude",
  "productName": "Multi-Claude",
  "version": "2.3.3",
  "private": true,
  "description": "Launch and manage separate Claude Desktop profiles. Not affiliated with Anthropic.",
  "main": "src/main/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "npm run build:renderer && electron-builder --publish never",
    "release": "npm run build:renderer && electron-builder --publish always"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "dev.multiclaude.app",
    "productName": "Multi-Claude",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "moshiuzzaman",
      "repo": "multi-claude",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Multi-Claude",
      "artifactName": "Multi-Claude-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Multi-Claude-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21"
  }
}
